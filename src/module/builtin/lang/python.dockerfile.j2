# Python {{ params.version }}
{% if base_os == "alpine" %}
RUN apk add --no-cache python3 py3-pip python3-dev
{% else %}
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv python3-dev \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
{% endif %}
{% if params.install_uv == "true" or params.install_uv is true %}
RUN pip3 install --break-system-packages uv || pip3 install uv
{% endif %}
{% if params.install_poetry == "true" or params.install_poetry is true %}
RUN pip3 install --break-system-packages poetry || pip3 install poetry
{% endif %}
