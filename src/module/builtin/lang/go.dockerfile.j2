# Go {{ params.version }}
{% if base_os == "alpine" %}
RUN wget -q "https://go.dev/dl/go{{ params.version }}.linux-$(uname -m | sed 's/x86_64/amd64/' | sed 's/aarch64/arm64/').tar.gz" -O /tmp/go.tar.gz \
    && tar -C /usr/local -xzf /tmp/go.tar.gz \
    && rm /tmp/go.tar.gz
ENV PATH="/usr/local/go/bin:${PATH}"
{% else %}
RUN curl -fsSL "https://go.dev/dl/go{{ params.version }}.linux-$(dpkg --print-architecture).tar.gz" | \
    tar -C /usr/local -xz
ENV PATH="/usr/local/go/bin:${PATH}"
{% endif %}
ENV GOPATH=/home/{{ image.user }}/go
ENV PATH="${GOPATH}/bin:${PATH}"
